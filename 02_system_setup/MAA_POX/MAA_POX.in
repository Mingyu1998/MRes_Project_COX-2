# Reconstructed from leap.log (the original tleap input was not saved).
# NOTE: MAA_POX.mol2 (MAA docked at the POX site, RESP charges from
# ../../01_ligand_parameterisation/metamizole_MAA/MAA_resp.mol2) is not in the repo;
# residue 1 of MAA_POX_dry.pdb holds the docked coordinates.
source leaprc.protein.ff19SB
source leaprc.gaff
source leaprc.water.tip3p
loadamberparams frcmod.ions234lm_1264_tip3p
addAtomTypes {
        { "M1"  "Fe" "sp3" }
        { "Y1"  "N" "sp3" }
        { "Y2"  "N" "sp3" }
        { "Y3"  "N" "sp3" }
        { "Y4"  "N" "sp3" }
        { "Y5"  "N" "sp3" }
        { "Y6"  "O" "sp3" }
}
HD1 = loadmol2 ../common/HD1.mol2
HD2 = loadmol2 ../common/HD2.mol2
FE1 = loadmol2 ../common/FE1.mol2
FE2 = loadmol2 ../common/FE2.mol2
H21 = loadmol2 ../common/H21.mol2
HEM = loadmol2 ../common/HEM.mol2
HOH = loadmol2 ../common/HOH.mol2
loadamberparams ../common/HE2.frcmod
loadamberparams ../common/HOH.frcmod
loadamberparams ../common/COX-2_mcpbpy.frcmod
mol = loadpdb ../common/COX-2_re.pdb
CHECK
bond mol.3.SG mol.14.SG
bond mol.4.SG mol.127.SG
bond mol.8.SG mol.24.SG
bond mol.26.SG mol.36.SG
bond mol.537.SG mol.543.SG
bond mol.556.SG mol.567.SG
bond mol.557.SG mol.680.SG
bond mol.561.SG mol.577.SG
bond mol.579.SG mol.589.SG
bond mol.1090.SG mol.1096.SG
bond mol.356.NE2 mol.553.FE
bond mol.552.NA mol.553.FE
bond mol.552.NB mol.553.FE
bond mol.552.NC mol.553.FE
bond mol.552.ND mol.553.FE
bond mol.355.C mol.356.N
bond mol.356.C mol.357.N
bond mol.908.C mol.909.N
bond mol.909.C mol.910.N
bond mol.909.NE2 mol.1106.FE
bond mol.1105.NA mol.1106.FE
bond mol.1105.NB mol.1106.FE
bond mol.1105.NC mol.1106.FE
bond mol.1105.ND mol.1106.FE
PAR = loadmol2 MAA_POX.mol2
loadamberparams ../../01_ligand_parameterisation/metamizole_MAA/MAA_may.frcmod
complex = combine {PAR mol}
savepdb complex MAA_POX_dry.pdb
addions complex Na+ 0
solvateBOX complex TIP3PBOX 20.0
addionsrand complex Na+ 219 Cl- 219
savepdb complex MAA_POX_solv.pdb
saveamberparm complex MAA_POX.parm7 MAA_POX.rst7
quit
